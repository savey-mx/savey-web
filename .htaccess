# ══════════════════════════════════════════════════════════
# SAVEY · configuración de Apache para Hostinger
# Reemplaza al archivo _headers, que solo funciona en Netlify.
# ══════════════════════════════════════════════════════════

# ── Forzar HTTPS ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # saveystudio.com sin www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ── Lo privado no se indexa ──
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(brief|album|i)/#">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
  </If>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Compresión ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Caché: las fotos y la música mucho, el HTML nada ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp     "access plus 1 year"
  ExpiresByType image/jpeg     "access plus 1 year"
  ExpiresByType image/png      "access plus 1 year"
  ExpiresByType audio/mpeg     "access plus 1 year"
  ExpiresByType text/css       "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html      "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Tipos que Apache a veces no reconoce ──
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType audio/mpeg .mp3
  AddType application/json .json
</IfModule>

# ── No listar el contenido de las carpetas ──
Options -Indexes

# ── Página de inicio ──
DirectoryIndex index.html
